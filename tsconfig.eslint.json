{
  "compilerOptions": {
    "pretty": true,
    "moduleResolution": "node",
    "noImplicitAny": true,
    "target": "ES6",
    "module": "commonjs",
    "lib": ["es5", "es6", "es7", "dom"],
    "sourceMap": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "baseUrl": ".",
    "allowJs": true
  },
  "files": ["tailwind.config.js"],
  "include": ["**/*.ts", "**/*.tsx", "packages/data/**/*"],
  "exclude": ["**/build", "**/dist", "out/*", "**/assets", "tailwind.config.js"]
}
