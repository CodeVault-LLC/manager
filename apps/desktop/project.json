{
  "name": "desktop",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/desktop"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev",
        "cwd": "apps/desktop"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build:win && pnpm run build:mac && pnpm run build:linux && pnpm run release",
        "cwd": "apps/desktop"
      }
    }
  },
  "tags": []
}
