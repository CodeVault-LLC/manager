{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    
    "../../packages/shared/**/*.d.ts",
    "../../packages/shared/**/*.ts",

    "../../libs/**/*.d.ts",
    "../../libs/**/*.ts",
    "../../libs/**/*.tsx", "app-info.ts", "package-info.ts", "dist-info.ts",

    "../../packages/**/*.d.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx",
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["./src/main/*"],
      "@shared/*": ["../../packages/shared/*"],
      "@manager/*": ["../../packages/*"],

      "@manager/common": ["../../libs/common/src/index.ts"],
      "@manager/common/*": ["../../libs/common/src/*"],

      "@manager/ui": ["../../libs/ui/src/index.ts"],
      "@manager/ui/*": ["../../libs/ui/src/*"],

      "@manager/data": ["../../packages/data/src/index.ts"],
      "@manager/data/*": ["../../packages/data/src/*"],

      "@manager/core": ["../../packages/core/src/index.ts"],
      "@manager/core/*": ["../../packages/core/src/*"]
  },
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
  }
}
