{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    
    "../../packages/shared/**/*.d.ts",
    "../../packages/shared/**/*.ts",

    "../../libs/**/*.d.ts",
    "../../libs/**/*.ts",
    "../../libs/**/*.tsx",

    "../../packages/**/*.d.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx",
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["../../packages/shared/*"],
      "@manager/*": ["../../libs/*"],

      "@manager/common": ["../../libs/common/src/index.ts"],
      "@manager/common/*": ["../../libs/common/src/*"],

      "@manager/ui": ["../../libs/ui/src/index.ts"],
      "@manager/ui/*": ["../../libs/ui/src/*"],

      "@manager/data": ["../../packages/data/src/index.ts"],
      "@manager/data/*": ["../../packages/data/src/*"],

      "@manager/core": ["../../packages/core/src/index.ts"],
      "@manager/core/*": ["../../packages/core/src/*"]
    }
  }
}
